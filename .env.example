# =============================================================================
# AI Voice Studio - environment configuration
# Copy to `.env` (backend + docker compose) and adjust.
# The frontend reads its own file: frontend/.env.local
# =============================================================================

# ---------- App ----------
APP_NAME="AI Voice Studio"
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- CORS ----------
# Comma-separated list of exact origins allowed to call the API.
# Never use "*" in production: uploads are user voice data.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Storage ----------
# Relative paths are resolved against the repository root.
STORAGE_DIR=storage
DATABASE_URL=sqlite:///storage/voice_studio.db

# ---------- AI engine ----------
# chatterbox = real model (downloads weights on first use)
# mock       = deterministic sine-wave engine, used by CI and unit tests
VOICE_ENGINE=chatterbox

# chatterbox variant: multilingual | english | turbo | nano
#   multilingual -> ChatterboxMultilingualTTS  (0.5B, 23 languages)
#   english      -> ChatterboxTTS              (0.5B, English only)
#   turbo        -> ChatterboxTurboTTS         (350M, English, CPU-friendly)
# "nano" is not offered: chatterbox-tts 0.1.7 (the pinned PyPI release) has
# no Nano checkpoint reachable through any public API -- see
# ai/chatterbox_engine.py's module docstring. "turbo" is the smallest,
# fastest variant this package actually provides.
CHATTERBOX_VARIANT=multilingual

# cuda | cpu | mps | auto
DEVICE=auto
# Load the model at startup instead of on first request (slower boot, faster first call)
PRELOAD_MODEL=false

# Where Hugging Face caches weights. Mounted as a volume in docker-compose.
HF_HOME=/root/.cache/huggingface

# ---------- Generation defaults ----------
DEFAULT_EXAGGERATION=0.5
DEFAULT_CFG_WEIGHT=0.5
DEFAULT_TEMPERATURE=0.8

# ---------- Limits / safety ----------
MAX_UPLOAD_BYTES=26214400          # 25 MiB
MIN_REFERENCE_SECONDS=3
MAX_REFERENCE_SECONDS=120
MAX_TEXT_CHARS=2000
MAX_VOICES=100
REQUIRE_CONSENT=true

# ---------- Rate limiting (in-process token bucket; swap for Redis at scale) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VOICE_CREATE_PER_HOUR=20
RATE_LIMIT_SPEECH_PER_HOUR=120
RATE_LIMIT_GLOBAL_PER_MINUTE=240

# ---------- Fairy-tale generation (multi-provider AI text generation) ------
# "Create Fairy Tale" is provider-independent -- see
# backend/app/services/ai_providers/. None of these is required
# individually; with all four unset, story generation returns a clear 503
# instead of an obscure error, and every other feature (cloning, default
# voices, Text to Speech) is entirely unaffected. Set at least one for
# fairy-tale generation to actually work. See README.md's "AI Providers"
# section for what each provider costs and how "auto" picks between them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Self-hosted only -- point this at your own Ollama server (not this app's
# own container; see README.md for why). Leave both unset to disable.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# "auto" mode: try this provider first if configured (unset = built-in order:
# openai, gemini, anthropic, ollama).
AI_PREFERRED_PROVIDER=
# "auto" mode: try free-tier/local providers before paid ones.
AI_AUTO_PREFER_FREE=false

RATE_LIMIT_STORY_PER_HOUR=30

# ---------- Book Reader (PDF upload / HTTP(S) link narration) --------------
# Deliberately separate from MAX_UPLOAD_BYTES (reference audio): PDFs and
# audio have unrelated realistic size ranges.
MAX_PDF_BYTES=20971520             # 20 MiB
MAX_PDF_PAGES=500
# Same cap applies whether the URL resolves to a PDF or an HTML page.
MAX_REMOTE_DOWNLOAD_BYTES=20971520
BOOK_FETCH_CONNECT_TIMEOUT_SECONDS=5
BOOK_FETCH_READ_TIMEOUT_SECONDS=20
BOOK_FETCH_MAX_REDIRECTS=5
# How much text one "Start Reading" call may synthesize -- a bounded batch,
# not the whole book (see README.md's Book Reader section). Separate from,
# and larger than, the manual-text/fairy-tale MAX_TEXT_CHARS above.
MAX_BOOK_NARRATION_CHARS=12000
# Extracted documents (metadata + text, never the original PDF bytes) older
# than this are swept on startup.
DOCUMENT_RETENTION_HOURS=24
RATE_LIMIT_BOOK_INGEST_PER_HOUR=20
RATE_LIMIT_BOOK_NARRATE_PER_HOUR=30
